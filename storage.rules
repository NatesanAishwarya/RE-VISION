rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function experiment(experimentId) {
      return firestore.get(/databases/(default)/documents/experiments/$(experimentId)).data;
    }

    match /experiments/{userId}/{experimentId}/{fileName} {
      allow read: if signedIn()
        && firestore.exists(/databases/(default)/documents/experiments/$(experimentId))
        && (experiment(experimentId).ownerId == request.auth.uid || experiment(experimentId).shared == true);
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && firestore.exists(/databases/(default)/documents/experiments/$(experimentId))
        && experiment(experimentId).ownerId == request.auth.uid
        && ((fileName == 'image' && request.resource.size <= 12 * 1024 * 1024 && request.resource.contentType.matches('image/.*'))
          || (fileName == 'data.json' && request.resource.size <= 50 * 1024 * 1024 && request.resource.contentType == 'application/json'));
      allow delete: if signedIn()
        && request.auth.uid == userId
        && firestore.exists(/databases/(default)/documents/experiments/$(experimentId))
        && experiment(experimentId).ownerId == request.auth.uid;
    }
  }
}
