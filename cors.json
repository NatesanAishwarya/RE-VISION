[
  {
    "origin": ["*"],
    "method": ["GET", "HEAD", "POST", "PUT", "DELETE"],
    "responseHeader": [
      "Authorization",
      "Content-Type",
      "Content-Length",
      "x-goog-resumable",
      "x-goog-upload-command",
      "x-goog-upload-protocol",
      "x-goog-upload-offset",
      "x-goog-upload-status",
      "x-goog-upload-url",
      "x-firebase-storage-version"
    ],
    "maxAgeSeconds": 3600
  }
]
